# ---- Secrets (NEVER commit) ----
# RSA private key for USB Boot signing
boot/rsa_key.pem
# same key, copied by make_usb_boot.py
boot/usb_boot_files/rsa_key.pem
# ACAS master key (device-specific)
.acas_key
**/.acas_key

# ---- Build artifacts ----
# Binaries built by `make build-bins` (src/ -> bin/)
/bin/*
!/bin/.gitkeep
/build/
*.o

# Boot files generated by make_usb_boot.py / build_initramfs.sh
boot/bootargs.bin
boot/root_rsa_pub_crc.bin
boot/initramfs_patched.uimg
boot/usb_boot_files/bootargs.bin
boot/usb_boot_files/root_rsa_pub_crc.bin
boot/usb_boot_files/initramfs_patched.uimg

# ---- Pulled from device (proprietary Android system libraries) ----
/android-libs/

# ---- User-supplied firmware / kernel image & extraction output ----
kernel.img
**/kernel.img
P187_6096.zip
update6096.enc
update6096.bin
boot.img
# Local-only kernel fetch helper (contains device-specific URL/password workflow)
get_kernel.sh
scripts/get_kernel.sh
_*.extracted/
firmware_extracted/

# ---- Work dirs ----
# Hotarun release binary fetched during `make fetch-hotarun` / `make deploy-hotarun`
# (always from https://github.com/yuchi0531/Hotarun/releases/latest/download/, no pin)
/tmp/
hotarun-linux-arm32
hotarun-linux-arm32.sha256

# ---- Python ----
__pycache__/
*.pyc

# ---- OS / editor junk ----
.DS_Store
*.swp
